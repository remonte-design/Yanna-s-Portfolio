{
  "hosting": {
    "public": "Frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server.js"
    ],
    "headers": [
      {
        "source": "**/*.@(css|js|svg|png|jpg|jpeg|webp|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
